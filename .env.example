# Copie para .env (que fica fora do Git), preencha e rode a app com:
#   uv run --env-file .env uvicorn descoberta.web.app:app --reload
#
# Rascunhos por LLM (só depois da sessão; desligados por padrão):
#   claude (API da Anthropic, precisa da chave abaixo), ollama (modelo local) ou desligado
DESCOBERTA_LLM_PROVEDOR=

# Chave da API da Anthropic (só para DESCOBERTA_LLM_PROVEDOR=claude). Nunca a coloque em
# outro arquivo, no código nem no Git.
ANTHROPIC_API_KEY=
