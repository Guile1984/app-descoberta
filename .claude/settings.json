{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.dev)",
      "Read(**/.env.development)",
      "Read(**/.env.prod)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Read(**/.env.bak)",
      "Read(**/.env.backup)",
      "Read(**/.env.old)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.dev)",
      "Edit(**/.env.development)",
      "Edit(**/.env.prod)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.bak)",
      "Edit(**/.env.backup)",
      "Edit(**/.env.old)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(grep * .env*)",
      "Bash(printenv ANTHROPIC_API_KEY*)",
      "Bash(echo $ANTHROPIC_API_KEY*)",
      "PowerShell(Get-Content .env*)",
      "PowerShell(gc .env*)",
      "PowerShell(cat .env*)",
      "PowerShell(type .env*)",
      "PowerShell(echo $env:ANTHROPIC_API_KEY*)",
      "PowerShell($env:ANTHROPIC_API_KEY*)"
    ]
  }
}
